MONGODB_URI=mongodb://127.0.0.1:27017/eid-salami
# Optional aliases also supported:
# MONGO_URI=mongodb://127.0.0.1:27017/eid-salami
# DATABASE_URL=mongodb://127.0.0.1:27017/eid-salami
JWT_SECRET=replace-this-with-a-long-random-secret
ADMIN_PASSWORD=change-me-owner-password
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-this-with-another-long-random-secret
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
# Optional: comma-separated Google emails that are allowed as admins.
# Leave blank to allow any Google account that signs in.
ADMIN_GOOGLE_EMAILS=
